# LLM provider via OpenCode Go subscription (OpenAI-compatible endpoint).
# IMPORTANT: Go models are served at https://opencode.ai/zen/go/v1 — the
# plain /zen/v1 URL bills from your credit balance instead of the Go plan.
# Get your key at https://opencode.ai/auth (it also lands in
# ~/.local/share/opencode/auth.json via the opencode TUI's /connect).
#
# Copy this file to .env and fill in LLM_API_KEY.
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# Optional fallback (only if you want a paid provider instead):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: override base URL for OpenAI-compatible endpoints (e.g. local model)
# OPENAI_BASE_URL=http://localhost:11434/v1
