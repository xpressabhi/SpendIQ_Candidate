# LLM provider via OpenCode Zen free endpoint (OpenAI-compatible, $0, no key needed)
# https://opencode.ai/zen/v1  — api_key "public"
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=public
LLM_MODEL=deepseek-v4-flash-free

# Optional fallback (only if you want a paid provider instead):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: override base URL for OpenAI-compatible endpoints (e.g. local model)
# OPENAI_BASE_URL=http://localhost:11434/v1
